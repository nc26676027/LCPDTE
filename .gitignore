# Local research inputs and pinned reference checkouts are reproduced from the
# hashes/URLs in research manifests; do not vendor third-party papers or repos.
research/sources/*.pdf
research/sources/*.txt
research/upstream/

# Workspace-only validators, rendered paper pages, and other scratch outputs.
tmp/

# Graphify is a local navigation aid. Reports, query memory, caches and rendered
# graphs are all reproducible and are not part of the library or research data.
graphify-out/

# Large, reproducible local toolchains.  The tracked explicit lock files under
# research/reproduction describe their exact contents.
research/toolchains/

# Python bytecode generated by estimator and verification scripts.
__pycache__/
*.py[cod]
